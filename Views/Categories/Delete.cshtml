@model Categorie
@{
    ViewData["Title"] = "Supprimer une Catégorie";
}

<div class="row">
    <div class="col-md-8">
        <h2>Supprimer la catégorie</h2>
        <hr />
        <h3>Êtes-vous sûr de vouloir supprimer cette catégorie ?</h3>
        <div>
            <dl class="row">
                <dt class="col-sm-2">Nom:</dt>
                <dd class="col-sm-10">@Model.Nom</dd>

                <dt class="col-sm-2">Description:</dt>
                <dd class="col-sm-10">@(Model.Description ?? "Aucune description")</dd>

                <dt class="col-sm-2">Nombre de livres:</dt>
                <dd class="col-sm-10">@(Model.Livres?.Count ?? 0)</dd>
            </dl>

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">Supprimer</button>
                <a asp-action="Index" class="btn btn-secondary">Annuler</a>
            </form>
        </div>
    </div>
</div>

