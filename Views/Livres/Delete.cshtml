@model Livre
@{
    ViewData["Title"] = "Supprimer un Livre";
}

<div class="row">
    <div class="col-md-8">
        <h2>Supprimer le livre</h2>
        <hr />
        <h3>Êtes-vous sûr de vouloir supprimer ce livre ?</h3>
        <div>
            <dl class="row">
                <dt class="col-sm-2">Titre:</dt>
                <dd class="col-sm-10">@Model.Titre</dd>

                <dt class="col-sm-2">Auteur:</dt>
                <dd class="col-sm-10">@(Model.Auteur ?? "Non spécifié")</dd>
            </dl>

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">Supprimer</button>
                <a asp-action="Index" class="btn btn-secondary">Annuler</a>
            </form>
        </div>
    </div>
</div>

