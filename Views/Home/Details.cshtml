@model Livre
@{
    ViewData["Title"] = Model.Titre;
    var isAuthenticated = ViewBag.IsAuthenticated as bool? ?? false;
    var userId = ViewBag.UserId as int?;
}

<div class="row">
    <div class="col-md-4">
        @if (!string.IsNullOrEmpty(Model.ImageCouverture))
        {
            <img src="@Model.ImageCouverture" class="img-fluid rounded" alt="@Model.Titre" />
        }
        else
        {
            <div class="bg-secondary d-flex align-items-center justify-content-center rounded" style="height: 400px;">
                <span class="text-white fs-1">📖</span>
            </div>
        }
    </div>
    <div class="col-md-8">
        <h1 class="display-4">@Model.Titre</h1>
        <hr />
        <dl class="row">
            <dt class="col-sm-3">Auteur:</dt>
            <dd class="col-sm-9">@(Model.Auteur ?? "Non spécifié")</dd>

            <dt class="col-sm-3">Catégorie:</dt>
            <dd class="col-sm-9">@(Model.Categorie?.Nom ?? "Non catégorisé")</dd>

            @if (Model.DatePublication.HasValue)
            {
                <dt class="col-sm-3">Date de publication:</dt>
                <dd class="col-sm-9">@Model.DatePublication.Value.ToShortDateString()</dd>
            }

            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <dt class="col-sm-3">Description:</dt>
                <dd class="col-sm-9">@Model.Description</dd>
            }
        </dl>

        <div class="mt-4">
            @if (isAuthenticated)
            {
                <div id="favori-section">
                    @if (userId.HasValue)
                    {
                        @Html.AntiForgeryToken()
                        <button id="btn-favori" class="btn btn-outline-primary me-2">
                            <span id="favori-icon">☆</span> <span id="favori-text">Ajouter aux favoris</span>
                        </button>
                    }
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.FichierPdf))
            {
                @if (isAuthenticated)
                {
                    <form asp-controller="Telechargements" asp-action="Download" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="livreId" value="@Model.Id" />
                        <button type="submit" class="btn btn-success">
                            📥 Télécharger le PDF
                        </button>
                    </form>
                }
                else
                {
                    <p class="text-muted">Connectez-vous pour télécharger ce livre</p>
                }
            }
            else
            {
                <p class="text-muted">Aucun fichier PDF disponible pour ce livre</p>
            }
        </div>

        <div class="mt-3">
            <a asp-action="Index" class="btn btn-secondary">Retour au catalogue</a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            var livreId = @Model.Id;
            var userId = @(userId.HasValue ? userId.Value : 0);

            if (userId > 0) {
                // Vérifier si le livre est en favori
                $.get('@Url.Action("Check", "Favoris")?livreId=' + livreId, function(data) {
                    if (data.isFavori) {
                        $('#favori-icon').text('⭐');
                        $('#favori-text').text('Retirer des favoris');
                        $('#btn-favori').data('is-favori', true);
                        if (data.favoriId) {
                            $('#btn-favori').data('favori-id', data.favoriId);
                        }
                    } else {
                        $('#favori-icon').text('☆');
                        $('#favori-text').text('Ajouter aux favoris');
                        $('#btn-favori').data('is-favori', false);
                    }
                });

                // Gérer le clic sur le bouton favori
                $('#btn-favori').click(function(e) {
                    e.preventDefault();
                    var isFavori = $(this).data('is-favori') || false;
                    var favoriId = $(this).data('favori-id');
                    var url, data, token;

                    if (isFavori) {
                        url = '@Url.Action("Remove", "Favoris")';
                        data = { favoriId: favoriId };
                    } else {
                        url = '@Url.Action("Add", "Favoris")';
                        data = { livreId: livreId };
                    }

                    // Récupérer le token anti-forgery
                    token = $('input[name="__RequestVerificationToken"]').val();
                    if (token) {
                        data.__RequestVerificationToken = token;
                    }

                    $.ajax({
                        url: url,
                        method: 'POST',
                        data: data,
                        success: function(response) {
                            if (response.success) {
                                location.reload(); // Recharger pour mettre à jour l'état
                            } else {
                                alert(response.message || 'Une erreur est survenue');
                            }
                        },
                        error: function() {
                            alert('Une erreur est survenue');
                        }
                    });
                });
            }
        });
    </script>
}

